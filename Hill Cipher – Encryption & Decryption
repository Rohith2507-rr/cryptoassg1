import numpy as np


def mod_inverse(a, m):
    for i in range(1, m):
        if (a * i) % m == 1:
            return i
    return None


def matrix_inverse(key_matrix):
    determinant = int(round(np.linalg.det(key_matrix)))
    determinant = determinant % 26

    inverse_det = mod_inverse(determinant, 26)

    if inverse_det is None:
        return None

    a = key_matrix[0][0]
    b = key_matrix[0][1]
    c = key_matrix[1][0]
    d = key_matrix[1][1]

    inverse_matrix = np.array([
        [d, -b],
        [-c, a]
    ])

    inverse_matrix = (inverse_det * inverse_matrix) % 26

    return inverse_matrix.astype(int)


def prepare_text(text):
    text = ''.join(ch for ch in text.upper() if ch.isalpha())

    if len(text) % 2 != 0:
        text += 'X'

    return text


def encrypt(text, key_matrix):
    text = prepare_text(text)
    result = ""

    for i in range(0, len(text), 2):
        pair = np.array([
            [ord(text[i]) - ord('A')],
            [ord(text[i + 1]) - ord('A')]
        ])

        encrypted = np.dot(key_matrix, pair) % 26

        result += chr(int(encrypted[0][0]) + ord('A'))
        result += chr(int(encrypted[1][0]) + ord('A'))

    return result


def decrypt(text, key_matrix):
    inverse_matrix = matrix_inverse(key_matrix)

    if inverse_matrix is None:
        return "Invalid key matrix"

    result = ""

    for i in range(0, len(text), 2):
        pair = np.array([
            [ord(text[i]) - ord('A')],
            [ord(text[i + 1]) - ord('A')]
        ])

        decrypted = np.dot(inverse_matrix, pair) % 26

        result += chr(int(decrypted[0][0]) + ord('A'))
        result += chr(int(decrypted[1][0]) + ord('A'))

    return result


key_matrix = np.array([
    [3, 3],
    [2, 5]
])

message = input("Enter message: ")

encrypted = encrypt(message, key_matrix)
decrypted = decrypt(encrypted, key_matrix)

print("Encrypted Message:", encrypted)
print("Decrypted Message:", decrypted)
